# Full MongoDB backup source. Create a dedicated read-only Atlas user.
MONGO_BACKUP_SOURCE_URI=mongodb+srv://BACKUP_READER:CHANGE_ME@SOURCE_CLUSTER/intern-attendance
MONGO_BACKUP_SOURCE_DB=intern-attendance

# Use a different Atlas cluster/project and a dedicated backup writer.
MONGO_BACKUP_TARGET_URI=mongodb+srv://BACKUP_WRITER:CHANGE_ME@BACKUP_CLUSTER/admin
MONGO_BACKUP_TARGET_DB_PREFIX=talenthub_backup

# Local archive settings. Relative paths resolve from the backend directory.
MONGO_BACKUP_DIR=backups
MONGO_BACKUP_FILE_PREFIX=talenthub_full
MONGO_BACKUP_RETENTION_DAYS=30
MONGO_BACKUP_RETENTION_COUNT=5

# Conservative transfer settings for Atlas reliability. Retries clean up any
# incomplete managed snapshot before trying again.
MONGO_BACKUP_PARALLEL_COLLECTIONS=1
MONGO_BACKUP_SOURCE_RETRY_COUNT=3
MONGO_BACKUP_REMOTE_RETRY_COUNT=3

# Admin scheduler: runs every day at 12:00 PM Asia/Colombo.
MONGO_BACKUP_SCHEDULER_ENABLED=true

# Optional absolute directory containing mongodump and mongorestore.
# MONGO_DATABASE_TOOLS_DIR=/usr/local/bin

# Guardrail: keep false. A separate cluster is required for real resilience.
MONGO_BACKUP_ALLOW_SAME_CLUSTER=false

# Destructive intern cleanup must be explicitly enabled. Keep false normally.
AUTO_CLEANUP_INACTIVE_INTERNS=false
